[[1]]$value
function (X_lab, Y_lab, mu_lab_list, X_unlab, mu_unlab_list, 
    gamma = NULL) 
{
    n <- nrow(X_lab)
    N <- nrow(X_unlab)
    eta <- N/(n + N)
    if (is.null(gamma)) 
        gamma <- -eta
    theta0 <- as.vector(solve(t(X_lab) %*% X_lab, t(X_lab) %*% 
        Y_lab))
    H_hat <- (t(X_lab) %*% X_lab)/n
    s_of <- function(theta, X, Y) as.vector(X %*% theta - Y) * 
        X
    f_of <- function(theta, X, mu_list) {
        do.call(cbind, lapply(mu_list, function(mu) as.vector(X %*% 
            theta - mu) * X))
    }
    s_lab <- s_of(theta0, X_lab, Y_lab)
    f_lab <- f_of(theta0, X_lab, mu_lab_list)
    f_unlab <- f_of(theta0, X_unlab, mu_unlab_list)
    s1 <- colMeans(s_lab)
    s2 <- colMeans(f_lab)
    s3 <- colMeans(f_unlab)
    T_hat <- cov(s_lab, f_lab) %*% solve(cov(f_lab))
    S_hat <- s1 + gamma * as.vector(T_hat %*% (s2 - s3))
    theta_pdc <- theta0 - as.vector(solve(H_hat, S_hat))
    Gamma_hat <- cov(s_lab) + (gamma^2/eta + 2 * gamma) * (T_hat %*% 
        cov(f_lab, s_lab))
    H_inv <- solve(H_hat)
    V_hat <- H_inv %*% Gamma_hat %*% t(H_inv)
    se <- sqrt(diag(V_hat)/n)
    list(est = theta_pdc, se = se)
}

