function (dat_tv, formula, family, robust = TRUE, est_type = "classical", 
    alpha = 0.05) 
{
    if (est_type == "classical") {
        dat_tv_fit <- filter(dat_tv, set == "testing")
    }
    else {
        dat_tv_fit <- dat_tv
    }
    if (est_type == "naive") {
        formula <- as.formula(call("~", as.name("pred"), formula[[3]]))
    }
    else {
        formula <- as.formula(call("~", as.name("y"), formula[[3]]))
    }
    fit <- glm(formula, data = dat_tv_fit, family = family)
    if (robust) {
        fit <- coeftest(fit, vcov. = vcovHC(fit, type = "HC"))
    }
    critical_val <- qnorm(1 - alpha/2)
    df <- broom::tidy(fit) %>% mutate(Method = est_type, conf.low = estimate - 
        critical_val * std.error, conf.high = estimate + critical_val * 
        std.error) %>% dplyr::select(Estimate = estimate, Std.Error = std.error, 
        Lower.CI = conf.low, Upper.CI = conf.high, Method, term)
    return(df)
}

